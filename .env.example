# ==============================================================
# AUTOSAR HLD Document Analysis Assistant - Environment Config
# ==============================================================

# Application Meta
PROJECT_NAME="AUTOSAR HLD Document Analysis Assistant"
VERSION="1.0.0"

# Storage & Databases
DATABASE_URL=sqlite:///./data/autosar.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
SAMPLE_DOCS_DIR=./data/sample_documents

# Embeddings & Vector Search
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
USE_FAST_EMBEDDINGS=1
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_FILE_SIZE_MB=50

# LLM Provider Configuration
# Options: "mock" (Built-in automotive reasoning engine), "ollama", "openai"
LLM_PROVIDER=mock
LLM_MODEL=llama3.1

# Optional Remote Providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
